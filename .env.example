# ════════════════════════════════════════════════════════════════
# Clonecast — Environment Variables
#
# El wizard web los configura por vos. Si querés editarlo a mano:
#   cp .env.example .env.local
#   chmod 600 .env.local
# Next.js carga automáticamente .env.local en server-side.
# ════════════════════════════════════════════════════════════════

# All API calls hit real services. Configure your keys via the /setup wizard
# (recommended — they're stored encrypted per-workspace) or paste them below
# for local development. Without keys the UI surfaces clear "configure your X
# API key" errors instead of fake data.

# ─── ANTHROPIC (obligatorio para script builder) ────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── OPENAI (Whisper transcripción) ─────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── ELEVENLABS (TTS con voz clonada) ───────────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── CARTESIA (TTS Sonic — más rápido y barato que ElevenLabs) ──
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# ─── HEYGEN (avatar IA, opcional según modo) ────────────────────
# https://app.heygen.com/settings/api
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# ─── HIGGSFIELD (B-roll personalizado) ──────────────────────────
# https://higgsfield.ai (settings → API)
HIGGSFIELD_API_KEY=

# ─── FAL.AI (fallback B-roll: Kling, Veo) ───────────────────────
# https://fal.ai/dashboard/keys
FAL_API_KEY=

# ─── RUNWAY (Gen-4.5 hero shots) ────────────────────────────────
# https://dev.runwayml.com/
RUNWAY_API_KEY=

# ─── GENERAL ────────────────────────────────────────────────────
CLONECAST_LANG=es-AR
CLONECAST_MAX_CONCURRENCY=3
LOG_LEVEL=info

# ─── STORAGE (local | r2) ───────────────────────────────────────
# local (default): outputs stay on disk, returned as file:// URLs.
# r2: push outputs to a Cloudflare R2 bucket (S3-compatible).
CLONECAST_STORAGE=local

# Cloudflare R2 — sólo se usan si CLONECAST_STORAGE=r2
# https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional: dominio público bound al bucket (https://cdn.tu-dominio.com)
R2_PUBLIC_BASE=
