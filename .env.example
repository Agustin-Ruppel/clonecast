# ════════════════════════════════════════════════════════════════
# Clonecast — Environment Variables
#
# El wizard web los configura por vos. Si querés editarlo a mano:
#   cp .env.example .env.local
#   chmod 600 .env.local
# Next.js carga automáticamente .env.local en server-side.
# ════════════════════════════════════════════════════════════════

# ─── MODO ────────────────────────────────────────────────────────
# true = no llama APIs reales, devuelve mocks. Útil para probar el flow.
CLONECAST_MOCK=true

# ─── ANTHROPIC (obligatorio para script builder) ────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── OPENAI (Whisper transcripción) ─────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── ELEVENLABS (TTS con voz clonada) ───────────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── HEYGEN (avatar IA, opcional según modo) ────────────────────
# https://app.heygen.com/settings/api
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# ─── HIGGSFIELD (B-roll personalizado) ──────────────────────────
# https://higgsfield.ai (settings → API)
HIGGSFIELD_API_KEY=

# ─── FAL.AI (fallback B-roll: Kling, Veo) ───────────────────────
# https://fal.ai/dashboard/keys
FAL_API_KEY=

# ─── GENERAL ────────────────────────────────────────────────────
CLONECAST_LANG=es-AR
CLONECAST_MAX_CONCURRENCY=3
LOG_LEVEL=info
