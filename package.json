{
  "name": "clonecast",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Open-source web pipeline to produce AI-clone video content (reels, classes, ads) with avatar + personalized B-rolls + word-level captions. Zero terminal needed.",
  "keywords": [
    "video",
    "ai",
    "avatar",
    "heygen",
    "elevenlabs",
    "hyperframes",
    "higgsfield",
    "whisper",
    "pipeline",
    "content-creation",
    "nextjs"
  ],
  "author": "Clonecast contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4242",
    "build": "next build",
    "start": "next start -p 4242",
    "launch": "node scripts/launch.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@hyperframes/core": "^0.6.40",
    "@hyperframes/player": "^0.6.40",
    "@hyperframes/producer": "^0.6.40",
    "@libsql/client": "^0.14.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "dotenv": "^16.4.5",
    "execa": "^9.5.0",
    "fs-extra": "^11.2.0",
    "keytar": "^7.9.0",
    "kysely": "^0.27.6",
    "next": "^15.0.3",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "happy-dom": "^16.8.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
